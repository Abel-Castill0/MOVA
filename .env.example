    APP_NAME=MOVA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de datos ────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mova
DB_USERNAME=root
DB_PASSWORD=

# ── Cola de trabajos (requerido para emails y WhatsApp) ──────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Correo (Gmail con App Password) ─────────────────────────────────────────
# Para obtener el App Password: myaccount.google.com/apppasswords
# Asegúrate de tener activada la verificación en dos pasos en tu cuenta Google.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=app_password_de_16_chars
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME="MOVA"

# ── Zoom (Server-to-Server OAuth) ───────────────────────────────────────────
# Crea una app "Server-to-Server OAuth" en marketplace.zoom.us
# Requiere scope: meeting:write:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_EMAIL=tu_correo@zoom.com
ZOOM_TIMEZONE=America/Lima

# ── Twilio WhatsApp Sandbox ──────────────────────────────────────────────────
# El número destinatario debe unirse al sandbox: enviar "join <código>" al +14155238886
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# ── Sentry (monitoreo de errores) ───────────────────────────────────────────
# Crea un proyecto en sentry.io y copia el DSN (PHP Laravel)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Production admin (used by ProductionSeeder) ──────────────────────────────
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── AWS (no utilizado actualmente) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Pusher (no utilizado actualmente) ───────────────────────────────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
