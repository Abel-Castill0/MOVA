    APP_NAME=MOVA
APP_ENV=local
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Barra de Debugbar (barryvdh/laravel-debugbar, dev-only): OFF por defecto —
# su overlay flotante intercepta clicks de Playwright y rompe el E2E. Poner
# en true solo cuando se está diagnosticando queries/tiempos a mano.
DEBUGBAR_ENABLED=false

# ── Base de datos ────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mova
DB_USERNAME=root
DB_PASSWORD=

# ── Cola de trabajos (requerido para emails y WhatsApp) ──────────────────────
BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Correo – Opción A: Gmail API HTTPS (recomendado para Railway Hobby sin dominio)
# Railway Hobby bloquea SMTP; esta opción usa la Gmail API por HTTPS.
# Para obtener las credenciales: php artisan mova:gmail-auth-url
MAIL_MAILER=gmail_api
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_ADDRESS=tu_correo@gmail.com
GMAIL_FROM_NAME="MOVA"
# MAIL_FROM_ADDRESS / MAIL_FROM_NAME SI se usan con gmail_api: desde H-05 el
# correo pasa por el pipeline estandar de Laravel, que construye la cabecera
# From con estos valores. Deben coincidir con la cuenta de GMAIL_FROM_ADDRESS
# (Gmail rechaza enviar en nombre de una direccion que no controla).
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME="MOVA"

# -- Correo - Opcion B: gmail_api con respaldo SMTP -------------------------
# `failover` intenta los transportes EN ORDEN y solo pasa al siguiente cuando
# el anterior lanza, asi que el doble envio es imposible por construccion.
# Requiere tener configurado tambien el bloque SMTP de la Opcion C.
# MAIL_MAILER=failover

# -- Correo - Opcion C: Gmail SMTP (solo para desarrollo local) -------------
# Para obtener el App Password: myaccount.google.com/apppasswords
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_correo@gmail.com
# MAIL_PASSWORD=app_password_de_16_chars
# MAIL_ENCRYPTION=tls

# ── WhatsApp Cloud API (Meta directo, ya no Twilio) ──────────────────────────
# WHATSAPP_ENABLED=false (default): el canal está desactivado globalmente.
# WHATSAPP_PROVIDER=fake (default): no envía nada real, solo para tests/dev.
# Cambiar a WHATSAPP_PROVIDER=meta requiere haber completado la afiliación de
# WhatsApp Business con Meta y tener plantillas aprobadas — ver
# docs/whatsapp-architecture.md y docs/WHATSAPP_PRODUCTION_NOTES.md. Nunca
# credenciales reales aquí ni en Git.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=fake
WHATSAPP_MODE=sandbox
WHATSAPP_REQUIRE_VERIFIED_PHONE=true
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_API_VERSION=v20.0
META_WHATSAPP_TEMPLATE_LANGUAGE=es_PE
META_WHATSAPP_TEMPLATE_GENERIC=
META_WHATSAPP_TEMPLATE_OTP=

# ── Google OAuth2 ("Continuar con Google") ───────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > Create Credentials >
# OAuth client ID > Web application. Authorized redirect URI:
# {APP_URL}/auth/google/callback
# Sin estas credenciales el botón sigue visible pero Google rechazará el
# intento de login — no bloquea el resto de la plataforma.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=  # opcional; por defecto {APP_URL}/auth/google/callback
# Google "en stand-by": el botón muestra un modal explicativo en vez de
# navegar, y /auth/google responde 503 aunque se acceda directo. Activar
# solo cuando GOOGLE_CLIENT_ID/SECRET reales estén configurados arriba.
GOOGLE_LOGIN_ENABLED=false

# ── Cloudinary (fotos de perfil) ──────────────────────────────────────────────
# cloudinary.com > Dashboard > Product Environment Credentials.
# Sin CLOUDINARY_URL, la subida de foto de perfil usa disco local
# (FILESYSTEM_DISK) automáticamente — no es obligatorio para desarrollar.
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# ── Sentry (monitoreo de errores) ───────────────────────────────────────────
# Crea un proyecto en sentry.io y copia el DSN (PHP Laravel)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Production admin (used by ProductionSeeder) ──────────────────────────────
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── AWS (no utilizado actualmente) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Pusher (WebSockets / notificaciones en tiempo real vía Laravel Echo) ────
# Requiere BROADCAST_DRIVER=pusher. Credenciales en dashboard.pusher.com.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Recargas manuales. Mantener desactivadas hasta configurar un destino verificado.
RECHARGES_ENABLED=false
RECHARGE_PAYMENT_DESTINATION=

# Pagos automáticos (Culqi/otro PSP) — capa opcional encima de las recargas
# manuales de arriba, no las reemplaza. 'fake' (default) no cobra nada real,
# solo sirve para tests/desarrollo. NO poner 'culqi' hasta implementar
# App\Payment\CulqiPaymentProvider (ver ese archivo y
# docs/payments-architecture.md) y tener cuenta comercial real. Nunca
# commitear llaves reales aquí ni en .env.
PAYMENT_PROVIDER=fake
CULQI_PUBLIC_KEY=
CULQI_PRIVATE_KEY=
CULQI_WEBHOOK_SECRET=
CULQI_ENV=test

# Mercado Pago — Payments API (POST/GET /v1/payments), Perú/MPE. La
# aplicación ya creada (App ID en el dashboard, NO hardcodeado aquí a
# propósito) se usa igual aunque se haya originado para Orders API — el
# access_token no está atado por Mercado Pago a un "api_type" declarado.
# NO poner 'mercadopago' en PAYMENT_PROVIDER hasta que el entorno TEST esté
# confirmado funcional (ver docs/payments-architecture.md y el comando de
# diagnóstico `php artisan mercadopago:diagnose`). Estos valores son
# SIEMPRE de TEST en este archivo — nunca credenciales productivas, ni aquí
# ni en .env real, se commitean a Git.
#
# MERCADOPAGO_WEBHOOK_SECRET NO viene de "credenciales"/access token: se
# genera aparte al configurar el webhook en el panel (Tus integraciones >
# Webhooks > Configurar notificación > Guardar configuración). No es
# necesario para `php artisan mercadopago:diagnose` (solo usa access_token).
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_ACCESS_TOKEN=
# Public key: no es secreta, pero tampoco se hardcodea aquí — cópiala del
# mismo panel que el Access Token cuando exista capa de checkout.
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# WEBHOOK ENABLEMENT: false hasta que el webhook esté REALMENTE configurado
# en el panel de Mercado Pago (Tus integraciones > Webhooks). En false,
# MERCADOPAGO_WEBHOOK_SECRET no es obligatorio y el endpoint rechaza
# cualquier notificación entrante sin importar la firma. Ver config/payments.php.
MERCADOPAGO_WEBHOOKS_ENABLED=false
# Application ID (dato público, ver "Tus integraciones" en el panel) — NO
# hardcodeado como default en config/payments.php a propósito. Requerido
# por ProviderGuard cuando PAYMENTS_ENABLED=true y PAYMENT_PROVIDER=mercadopago.
MERCADOPAGO_APPLICATION_ID=
# collector_id/user_id del vendedor esperado — igual, requerido por
# ProviderGuard cuando los pagos están realmente habilitados. Ver
# config/payments.php.
MERCADOPAGO_EXPECTED_COLLECTOR_ID=
# TEST hasta activar producción de verdad — interruptor explícito, nunca
# inferido del prefijo de la credencial (ver CLAUDE.md).
MERCADOPAGO_EXPECTED_LIVE_MODE=false
# Umbrales de recuperación (MercadoPagoWebhookRecoveryService) — opcionales,
# los valores de abajo son los defaults reales si se dejan sin definir.
MERCADOPAGO_RECOVERY_STALE_RECEIVED_MINUTES=15
MERCADOPAGO_RECOVERY_STUCK_ORDER_MINUTES=30
MERCADOPAGO_RECOVERY_PAID_LOOKBACK_DAYS=90
MERCADOPAGO_RECOVERY_PAID_LOOKBACK_MIN_AGE_MINUTES=60
MERCADOPAGO_RECOVERY_MAX_ATTEMPTS=3
MERCADOPAGO_RECOVERY_BATCH_SIZE=200
# UNKNOWN PAYMENT RECOVERY: presupuesto de la búsqueda dirigida por
# external_reference para intentos con resultado incierto (timeout/5xx/429/
# 2xx sin id) — distinto del budget de arriba (ese es de payment_webhooks).
MERCADOPAGO_RECOVERY_UNCERTAIN_MIN_AGE_MINUTES=5
MERCADOPAGO_RECOVERY_UNCERTAIN_MAX_ATTEMPTS=5

# C-1 — liquidación automática de créditos (mova:settle-lessons). Ver
# config/credits.php para el razonamiento completo de cada ventana.
CREDITS_SETTLEMENT_GRACE_DAYS=7
CREDITS_UNCONFIRMED_DAYS=7
CREDITS_REPORT_REMINDER_DELAY_HOURS=2

# -- Ciclo de vida de las solicitudes de clase (seccion 14) ---------------
# Una solicitud abierta que ningun profesor responde caduca pasado este plazo.
# DEBE ser mayor que las 12 h del recordatorio de solicitudes sin responder,
# o el profesor recibiria un aviso sobre algo que ya no puede aceptar.
CLASS_REQUEST_EXPIRY_HOURS=24

# ── Diagnóstico IA (Fase 4A.3) ──────────────────────────────────────────────
# Mantener en false hasta validar localmente con key de prueba.
# La IA solo enriquece el diagnóstico; nunca elige ni rankea profesores.
# Providers: openai | gemini  — NO agregar keys reales en git.
DIAGNOSTIC_AI_ENABLED=false
DIAGNOSTIC_AI_PROVIDER=openai
DIAGNOSTIC_AI_TIMEOUT=8
DIAGNOSTIC_AI_MAX_TOKENS=300
# Límites de uso (0 = sin límite)
DIAGNOSTIC_AI_DAILY_LIMIT=50
DIAGNOSTIC_AI_MONTHLY_LIMIT=500
DIAGNOSTIC_AI_AUTO_DISABLE_ON_ERROR=false
# OpenAI provider
DIAGNOSTIC_AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Gemini provider
DIAGNOSTIC_GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=

# ── JaaS (Jitsi as a Service, 8x8.vc) — videollamada embebida sin el límite
# de 5 minutos que aplica al meet.jit.si público en producción ──────────────
# 1. jaas.8x8.vc > Create API key. Copia el App ID y el Key ID (kid) de esa
#    misma API key — son valores distintos, ambos hacen falta.
# 2. Descarga la private key (PEM). JAAS_PRIVATE_KEY va en base64 de una sola
#    línea (evita problemas de parseo con los saltos de línea del PEM):
#    base64 -w0 tu-private-key.pem
# Sin JAAS_KEY_ID, JaaS rechaza el JWT con "Missing Key ID (kid)".
JAAS_APP_ID=
JAAS_PRIVATE_KEY=
JAAS_KEY_ID=
