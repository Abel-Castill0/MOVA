# FrankenPHP/Caddy mínimo para MOVA.
# TLS lo termina el ingress de Azure Container Apps; aquí solo HTTP en $PORT.
# TrustProxies ya confía en X-Forwarded-* (app/Http/Middleware/TrustProxies.php).
{
	frankenphp
	auto_https off
}

:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	# Caché HTTP de estáticos. Las respuestas de Laravel (HTML, JSON de Inertia) no cambian: solo rutas de archivos.
	# /build/*: Vite pone el hash del contenido en cada nombre; un archivo nunca cambia, así que se cachea un año.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	# Fuentes, imágenes y medios sin hash en el nombre: 7 días, revalidando después (un reemplazo con el mismo
	# nombre llega como mucho a la semana). Solo si el archivo existe, para no tocar rutas de Laravel.
	@static {
		path /fonts/* /images/* /media/* /favicon.ico /manifest.json
		file
	}
	header @static Cache-Control "public, max-age=604800"

	php_server
}
