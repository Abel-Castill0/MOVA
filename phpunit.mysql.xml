<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!-- MOVA MYSQL QA GATE, NO es el gate normal (ver phpunit.xml). Corre
         los mismos tests de tests/Feature pero contra MySQL real (conexión
         'mysql_qa', base de datos 'mova_qa' fija en código), para ejercitar
         semántica que SQLite en memoria no puede: locking real de filas,
         constraints/engine reales de MySQL. Uso normal: con la opción
         "filter" de phpunit para correr solo el subconjunto de alto valor
         (ver docs/SESSION_HANDOFF.md o el comando mova:qa-mysql-fresh-migrate
         para preparar el schema antes de correr esto).
         tests/CreatesApplication::guardSafeTestingEnvironment() falla
         cerrado si DB_CONNECTION no es exactamente 'mysql_qa' con
         database 'mova_qa' cuando APP_ENV=testing.

         Aislamiento de DDL: los tests que invocan Migration::up()/down()
         directamente (MercadoPagoMigrationsTest,
         RechargeOperationNumberNullableMigrationTest, y dos métodos de
         MonetizationIntegrityTest) ya llevan #[RunClassInSeparateProcess] o
         #[RunInSeparateProcess] en su propio código — PHPUnit los corre en
         un proceso PHP aparte automáticamente, sin necesidad de invocarlos
         por separado a mano ni de recordar un orden de ejecución. Una sola
         invocación de phpunit contra este archivo, con o sin la opción
         "filter", es segura. -->
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <!-- Único cambio real respecto a phpunit.xml: la conexión por
             defecto. El nombre de la base de datos ('mova_qa') NO se fuerza
             aquí porque está hardcodeado en config/database.php — a
             propósito, para que ninguna variable de entorno pueda
             desviarlo. -->
        <env name="DB_CONNECTION" value="mysql_qa" force="true"/>
        <env name="DB_FOREIGN_KEYS" value="true" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="DIAGNOSTIC_AI_ENABLED" value="false" force="true"/>
        <env name="WHATSAPP_ENABLED" value="false" force="true"/>
        <env name="PAYMENTS_ENABLED" value="false" force="true"/>
        <env name="PAYMENT_PROVIDER" value="fake" force="true"/>
        <env name="ZOOM_ACCOUNT_ID" value="" force="true"/>
        <env name="ZOOM_CLIENT_ID" value="" force="true"/>
        <env name="ZOOM_CLIENT_SECRET" value="" force="true"/>
        <env name="ZOOM_EMAIL" value="" force="true"/>
        <env name="GMAIL_CLIENT_ID" value="" force="true"/>
        <env name="GMAIL_CLIENT_SECRET" value="" force="true"/>
        <env name="GMAIL_REFRESH_TOKEN" value="" force="true"/>
        <!-- CLOUDINARY_URL fijada a vacío, no ausente: si la dejamos libre,
             config/services.php la leería del .env del desarrollador
             (env() no cacheado en testing) y los tests de avatar tocando la
             rama "configurada" de CloudinaryService harían llamadas de red
             reales. Mismo criterio que GMAIL/SENTRY arriba. -->
        <env name="CLOUDINARY_URL" value="" force="true"/>
        <!-- Sin broadcasting real en tests: .env.example trae pusher y el CI lo copia. -->
        <env name="BROADCAST_DRIVER" value="null" force="true"/>
        <env name="OPENAI_API_KEY" value="" force="true"/>
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="SENTRY_LARAVEL_DSN" value="" force="true"/>
        <env name="SENTRY_DSN" value="" force="true"/>
        <env name="JAAS_APP_ID" value="test-app-id" force="true"/>
        <env name="JAAS_KEY_ID" value="test-key-id" force="true"/>
        <!-- FIXTURE CRIPTOGRÁFICO SINTÉTICO — no es una credencial.
             Clave RSA-2048 generada para las pruebas, en base64. JaaSService
             solo la usa para FIRMAR un JWT en local (JWT::encode(..., 'RS256'),
             JaaSService.php:80): no se contacta con ningún servidor de Jitsi,
             así que cualquier par de claves válido sirve y ninguna credencial
             real interviene. Los identificadores que la acompañan son
             marcadores ('test-app-id' / 'test-key-id'), no un vpaas-magic-cookie
             real, y JAAS_PRIVATE_KEY está VACÍA en .env.example: la clave de
             producción vive solo en .env, que no se versiona.
             Se deja inline a propósito. Sustituirla por un mock debilitaría las
             pruebas, que hoy verifican la firma RS256 de verdad
             (JitsiAccessWindowTest, MonetizationIntegrityTest). -->
        <env name="JAAS_PRIVATE_KEY" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
