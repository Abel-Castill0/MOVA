<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!-- La suite "Unit" se eliminó junto con el ExampleTest de boilerplate que
         era su único contenido: MOVA no tiene tests unitarios puros, todo el
         valor está en los Feature tests (que ejercitan rutas, políticas y
         transacciones reales). Dejar un <testsuite> apuntando a un directorio
         vacío rompe PHPUnit ("Test directory not found"), porque git no
         versiona directorios vacíos. Si en el futuro se agregan tests
         unitarios de verdad, volver a declarar la suite junto con ellos. -->
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_DRIVER" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_FOREIGN_KEYS" value="true" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="DIAGNOSTIC_AI_ENABLED" value="false" force="true"/>
        <env name="WHATSAPP_ENABLED" value="false" force="true"/>
        <!-- TEST ENV ISOLATION (MOVA Yape Checkout Pre-Card Hardening): sin
             esto, config/payments.php lee PAYMENTS_ENABLED/PAYMENT_PROVIDER
             directo del .env local del desarrollador (env() no cacheado en
             testing) — dos tests (PaymentOrderTest, ProviderGuardTest)
             asumían "el contenedor resuelve FakePaymentProvider por
             defecto" sin fijar su propio config(), y ese supuesto se rompía
             en cualquier máquina cuyo .env tuviera Mercado Pago activado
             (exactamente lo que pasó durante el E2E real de esta fase).
             Mismo patrón que WHATSAPP_ENABLED arriba: un default forzado y
             centralizado, no un Config::set repetido en cada test. Un test
             que necesite un proveedor real (MercadoPagoPaymentProviderTest,
             CreditCheckoutControllerTest, etc.) sigue pudiendo hacer su
             propio config([...]) en setUp() como ya hacían. -->
        <env name="PAYMENTS_ENABLED" value="false" force="true"/>
        <env name="PAYMENT_PROVIDER" value="fake" force="true"/>
        <env name="ZOOM_ACCOUNT_ID" value="" force="true"/>
        <env name="ZOOM_CLIENT_ID" value="" force="true"/>
        <env name="ZOOM_CLIENT_SECRET" value="" force="true"/>
        <env name="ZOOM_EMAIL" value="" force="true"/>
        <env name="GMAIL_CLIENT_ID" value="" force="true"/>
        <env name="GMAIL_CLIENT_SECRET" value="" force="true"/>
        <env name="GMAIL_REFRESH_TOKEN" value="" force="true"/>
        <env name="OPENAI_API_KEY" value="" force="true"/>
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="SENTRY_LARAVEL_DSN" value="" force="true"/>
        <env name="SENTRY_DSN" value="" force="true"/>
        <!-- Keypair de prueba, sin relación con ninguna cuenta real de JaaS —
             solo para que JaasService pueda firmar un JWT sintácticamente
             válido en tests (no hay llamada de red que valide la firma). -->
        <env name="JAAS_APP_ID" value="test-app-id" force="true"/>
        <env name="JAAS_KEY_ID" value="test-key-id" force="true"/>
        <!-- FIXTURE CRIPTOGRÁFICO SINTÉTICO — no es una credencial.
             Clave RSA-2048 generada para las pruebas, en base64. JaaSService
             solo la usa para FIRMAR un JWT en local (JWT::encode(..., 'RS256'),
             JaaSService.php:80): no se contacta con ningún servidor de Jitsi,
             así que cualquier par de claves válido sirve y ninguna credencial
             real interviene. Los identificadores que la acompañan son
             marcadores ('test-app-id' / 'test-key-id'), no un vpaas-magic-cookie
             real, y JAAS_PRIVATE_KEY está VACÍA en .env.example: la clave de
             producción vive solo en .env, que no se versiona.
             Se deja inline a propósito. Sustituirla por un mock debilitaría las
             pruebas, que hoy verifican la firma RS256 de verdad
             (JitsiAccessWindowTest, MonetizationIntegrityTest). -->
        <env name="JAAS_PRIVATE_KEY" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
