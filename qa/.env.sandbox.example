# MOVA — credenciales de SANDBOX/PRUEBA para las sondas locales (scripts/sandbox-smoke.sh).
#
# Copia este archivo a `qa/.env.sandbox` (ignorado por Git: NUNCA se versiona)
# y completa los valores en TU máquina. No pegues estos valores en el chat, en
# issues, en commits ni en documentación. Los comandos solo imprimen estados.
#
# Solo credenciales de PRUEBA. Las sondas se niegan a correr fuera de local/testing
# y con EXPECTED_LIVE_MODE distinto de false.

# ── Mercado Pago (panel: Tus integraciones → tu aplicación → Credenciales de prueba) ──
# Access Token de PRUEBA del vendedor de prueba (empieza por TEST- en la mayoría de cuentas).
MERCADOPAGO_ACCESS_TOKEN=
# Public Key de PRUEBA de la MISMA aplicación.
MERCADOPAGO_PUBLIC_KEY=
# Número de la aplicación (Tus integraciones → Detalles de la aplicación).
MERCADOPAGO_APPLICATION_ID=
# ID numérico del usuario VENDEDOR de prueba (el "user_id" de la cuenta de prueba que cobra).
MERCADOPAGO_EXPECTED_COLLECTOR_ID=
# Opcional: clave secreta del webhook (Tus integraciones → Webhooks → Configurar notificaciones
# → Modo de prueba → "Clave secreta"). Sin ella, la sonda omite la fase del webhook firmado.
MERCADOPAGO_WEBHOOK_SECRET=
# Correo del COMPRADOR de prueba (panel MP → Cuentas de prueba, distinto del vendedor). Sin él,
# el sandbox responde 403 "Payer email forbidden" al crear el pago.
MERCADOPAGO_SANDBOX_PAYER_EMAIL=

# ── JaaS / 8x8 (panel: jaas.8x8.vc → API keys) ──
# AppID del proyecto JaaS (formato vpaas-magic-cookie-xxxx).
JAAS_APP_ID=
# Key ID de la API key (formato vpaas-magic-cookie-xxxx/yyyy).
JAAS_KEY_ID=
# Clave privada RSA (PEM) de esa API key, en BASE64 de UNA sola línea (así la lee config/jaas.php):
#   base64 -w0 tu-private-key.pem
JAAS_PRIVATE_KEY=

# ── Cloudinary (consola: Settings → API Keys) ──
# URL completa cloudinary://API_KEY:API_SECRET@CLOUD_NAME. Usa un cloud/carpeta de PRUEBA.
CLOUDINARY_URL=

# ── Sentry (proyecto: Settings → Client Keys (DSN)) ──
# DSN de un proyecto/entorno de PRUEBA (no el de producción).
SENTRY_LARAVEL_DSN=

# ── Correo real de prueba (ver sección de correo del ledger) ──
# Gmail API: solo si decides mantenerlo. Si pasas a otro proveedor, se documentan sus nombres.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_ADDRESS=
# Buzón de PRUEBA que recibe los correos de la sonda (una cuenta tuya, nunca un usuario real).
MAIL_SMOKE_RECIPIENT=
