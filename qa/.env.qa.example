# Plantilla de qa/.env.qa — SIN secretos. Copiar a qa/.env.qa (gitignored) y
# rellenar solo lo que necesites; nunca commitear el archivo real.
#
# F-24A: BASE_URL debe ser siempre local por defecto. No pegues aquí, ni en
# el .env.qa real, una URL ni credenciales de producción — ver
# docs/MOVA_QA_SECURITY_POLICY.md para la política completa.
BASE_URL=http://localhost:8000

# Las cuentas de QA local (padre/profesor) NO se configuran aquí — vienen de
# LocalTestDataSeeder (padre@mova.test / profesor@mova.test, password123).
# Una sola fuente de verdad; no dupliques esas credenciales en este archivo.

# Opcional — solo si usas qa/check-gmail-inbox.mjs contra una cuenta de
# Gmail dedicada a QA (nunca una cuenta personal):
GMAIL_READONLY_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Opcional — solo si necesitas consultar el estado de un mensaje vía la API
# de Twilio (histórico; MOVA ya no usa Twilio para WhatsApp, ver Meta Cloud API):
TWILIO_SID=
TWILIO_AUTH_TOKEN=
